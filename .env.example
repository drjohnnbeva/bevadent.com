# Copia estas variables en Render (Environment) — nunca las subas al repositorio.

# Dirección pública de la app, sin diagonal final
APP_URL=https://odontocostos.com

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secreta: solo el servidor la usa

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Cupón de fundador creado por `npm run stripe:setup` (opcional)
STRIPE_FOUNDER_COUPON=FUNDADOR
# Portal del cliente creado por `npm run stripe:setup` (opcional)
STRIPE_PORTAL_CONFIG=bpc_...

# Entrar con Google: pon 1 después de activarlo en Supabase (opcional)
GOOGLE_AUTH=0

# Contacto que aparece en la app y en los legales
SUPPORT_EMAIL=hola@odontocostos.com
