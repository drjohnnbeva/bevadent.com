# Copia estas variables en Render (Environment) — nunca las subas al repositorio.

# Dirección pública de la app, sin diagonal final
APP_URL=https://odontocostos.com

# Base de datos Postgres. En Render: odontocostos-db → Connect → Internal Database URL.
# Sin ella el sitio funciona, pero sin cuentas (los datos se quedan en cada dispositivo).
DATABASE_URL=postgresql://usuario:contraseña@dpg-xxxxxxxx-a/odontocostos_db

# Contraseña del panel del dueño: https://odontocostos.com/admin
ADMIN_PASSWORD=una-contraseña-larga

# Contacto que aparece en la app y en los legales
SUPPORT_EMAIL=hola@odontocostos.com

# Correo para "¿Olvidaste tu contraseña?" (opcional). Con Gmail: tu correo y una contraseña de aplicación
# (myaccount.google.com/apppasswords, requiere verificación en dos pasos). Sin esto, las solicitudes llegan al panel.
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# Otro proveedor: SMTP_HOST (por omisión smtp.gmail.com), SMTP_PORT (465) y MAIL_FROM

# Stripe (Developers → API keys / Webhooks). Sin estas dos, la app está en beta: Pro gratis para quien crea cuenta.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Cupón de fundador creado por `npm run stripe:setup` (opcional)
STRIPE_FOUNDER_COUPON=FUNDADOR
# Portal del cliente creado por `npm run stripe:setup` (opcional)
STRIPE_PORTAL_CONFIG=bpc_...

# Días de Pro gratis al crear cuenta (opcional): durante la beta y con cobro activo
BETA_TRIAL_DAYS=60
TRIAL_DAYS=14
