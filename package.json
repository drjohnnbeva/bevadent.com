{
  "name": "odontocostos",
  "private": true,
  "version": "1.0.0",
  "description": "Costos, precios y finanzas para consultorios dentales en México.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode preview --outDir preview-dist",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && npm run test:server && npm run test:live && npm run test:devices && npm run build:preview && npm run test:ui",
    "check": "npm run typecheck && npm run test && npm run build",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "test:server": "node e2e/server-test.mjs",
    "test:live": "node e2e/live-test.mjs",
    "test:ui": "node e2e/smoke.mjs",
    "test:devices": "node e2e/devices.mjs",
    "images": "node scripts/make-images.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "10.0.16",
    "pg": "^8.23.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jspdf": "^3.0.4",
    "playwright": "1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
